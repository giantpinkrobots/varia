{
    "id": "io.github.giantpinkrobots.varia",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "//!": "!!!!!!Also update the GNOME version in ./.github/workflows/flatpak-package.yml",
    "sdk": "org.gnome.Sdk",
    "command": "varia",
    "//": "Justifications for the permissions: This program utilizes aria2c, and aria2c requires the networking permission and the xdg-download directory in order to download files. It also has a 'shut down once all downloads are completed' feature that requires access to org.freedesktop.login1. Access to the GTK4 theme directory is required for a secret easter-egg function allowing for the usage of the Plasma color scheme.",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-download",
        "--system-talk-name=org.freedesktop.login1",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "ffmpeg",
            "config-opts": [
                "--disable-debug",
                "--disable-devices",
                "--disable-doc",
                "--disable-ffplay",
                "--disable-static",
                "--enable-gnutls",
                "--enable-libmp3lame",
                "--enable-libopus",
                "--enable-libvorbis",
                "--enable-shared"
            ],
            "cleanup": [
                "/share/ffmpeg"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n9.0.tar.gz",
                    "sha256": "d97647ace36a307f17ba2bca052d68937487bed8682e1eb9b6737076a9c442b7"
                }
            ]
        },
        {
            "name": "7-zip",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xf ./7z*",
                "install -Dm755 7zzs /app/bin/7zz"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://github.com/ip7z/7zip/releases/download/26.04/7z2604-linux-x64.tar.xz",
                    "sha256": "fc0327ba27e89bd086cf426dff17d77de582953cdbbc10a6576540a06853ffcd"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://github.com/ip7z/7zip/releases/download/26.04/7z2604-linux-arm64.tar.xz",
                    "sha256": "5b0ac3aa91c1e3499f011d6af69d7f6b4de3ef2f011d9e2ff44c58ebd04aa388"
                }
            ]
        },
        {
            "name": "quickjs",
            "buildsystem": "simple",
            "build-commands": [
                "make qjs cxxflags='$CXXFLAGS' linkflags='$LDFLAGS' -j $FLATPAK_BUILDER_N_JOBS",
                "strip qjs",
                "install -m 755 qjs /app/bin/"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/bellard/quickjs",
                    "commit": "84e723f1ace5e3823cef8149dd0f890fe74b77ce"
                }
            ]
        },
        "./flatpak_extra_manifests/python3-aria2p.json",
        "./flatpak_extra_manifests/python3-emoji-country-flag.json",
        "./flatpak_extra_manifests/python3-dbus-next.json",
        "./shared-modules/libayatana-appindicator/libayatana-appindicator-gtk3.json",
        "./flatpak_extra_manifests/python3-yt-dlp.json",
        {
            "name": "boost",
            "buildsystem": "simple",
            "build-commands": [
                "./bootstrap.sh --prefix=/app",
                "./b2 install --with-headers --with-python cxxflags='$CXXFLAGS' linkflags='$LDFLAGS' -j $FLATPAK_BUILDER_N_JOBS"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/boostorg/boost/releases/download/boost-1.92.0/boost-1.92.0-b2-nodocs.tar.xz",
                    "sha256": "ea7b982002cc9dfbe59b0b217b206f470dc75f3de0bb2973d844118934d82411"
                }
            ]
        },
        {
            "name": "libtorrent",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DBUILD_SHARED_LIBS=OFF",
                "-DCMAKE_BUILD_TYPE=Release",
                "-Dpython-bindings=ON",
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
            ],
            "build-commands": [
                "ninja install"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/arvidn/libtorrent.git",
                    "commit": "6da363d2994f17c0b3c0450d124cf73a31a73847"
                }
            ]
        },
        {
            "name": "aria2-next",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 aria2-next-* /app/bin/aria2-next"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://github.com/AnInsomniacy/aria2-next/releases/download/v3.0.7/aria2-next-3.0.7-linux-x86_64",
                    "sha256": "ba9191b084c0d853b626c1a163bd472e78ef61c9a8498e93f5c6519999dc90a8"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://github.com/AnInsomniacy/aria2-next/releases/download/v3.0.7/aria2-next-3.0.7-linux-aarch64",
                    "sha256": "8abfb13eddfc669267fc608fd6b116c483255ea018d033d2448a003b97faeb2b"
                }
            ]
        },
        {
            "name": "varia",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ],
            "config-opts": [
                "--libdir=lib"
            ]
        }
    ]
}